{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": "frontend/src",
    "outDir": "pi_camera_in_docker/static/js",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "noEmitOnError": true,
    "sourceMap": false,
    "declaration": false,
    "allowJs": false,
    "skipLibCheck": true
  },
  "include": ["frontend/src/**/*.ts"]
}
