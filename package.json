{
  "type": "module",
  "scripts": {
    "build:frontend": "tsc -p tsconfig.json",
    "lint": "eslint . --ignore-pattern 'node_modules/**' --ignore-pattern 'docs/_build/**' --ignore-pattern 'docs/_autosummary/**'",
    "type-check": "tsc -p tsconfig.json --noEmit",
    "test:frontend": "tsx --test tests/frontend/*.test.mjs",
    "health:frontend": "node scripts/frontend-health.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.12.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0"
  }
}
